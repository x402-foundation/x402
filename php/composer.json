{
    "name": "x402/x402",
    "description": "PHP implementation of the x402 payment protocol",
    "type": "library",
    "keywords": [
        "x402",
        "payments",
        "http-402",
        "agentic",
        "stablecoin"
    ],
    "homepage": "https://x402.org",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "X402\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "X402\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
