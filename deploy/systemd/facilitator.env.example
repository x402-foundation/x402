# Non-secret config for hoodgate-facilitator.service
# Copy to /etc/hoodgate/facilitator.env (chmod 644, owned root:hoodgate)

# ── Network ────────────────────────────────────────────────────────
PORT=3001
CHAIN_ID=46630
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ── RPC transport tuning ──────────────────────────────────────────
RPC_TIMEOUT_MS=6000
RPC_RETRY_COUNT=2
RPC_RETRY_DELAY_MS=300

# ── Proxy / CORS ──────────────────────────────────────────────────
# Number of trusted proxy hops in front of us. Direct=0, single nginx=1,
# Cloudflare→nginx=2. Wrong value lets X-Forwarded-For spoof rate limits.
TRUST_PROXY_HOPS=1
# Comma-separated origins allowed to hit /verify + /settle from a browser.
# Empty = no CORS headers emitted (server-to-server is unaffected).
CORS_ORIGINS=https://demo.hoodgate.example

# ── Token ────────────────────────────────────────────────────────
MOCK_USDG_ADDRESS=0xdDC7e17D6c06F8c5126b65fc9164481D87e6edE4
# Set to 1 for mainnet — refuse boot if the token contract doesn't
# validate. Left off on testnet for convenience.
STRICT_TOKEN_CHECK=0

# ── Balance thresholds ────────────────────────────────────────────
# 0.001 ETH — below this /health returns 503.
MIN_GAS_BALANCE_WEI=1000000000000000
# 0.002 ETH — soft warn, fires alert webhook once on cross.
ALERT_GAS_BALANCE_WEI=2000000000000000

# ── Alerting ──────────────────────────────────────────────────────
# Slack/Discord/PagerDuty webhook. Empty = log-only.
ALERT_WEBHOOK_URL=

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
