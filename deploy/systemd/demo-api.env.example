# Config for hoodgate-demo-api.service
# Copy to /etc/hoodgate/demo-api.env (chmod 644, owned root:hoodgate)

PORT=3005
FACILITATOR_URL=http://127.0.0.1:3001
CHAIN_ID=46630

# Upstream weather fetch timeout (ms). Beyond this we return 503 to the
# client BEFORE settling — this is the refund-risk fix (C5).
WTTR_TIMEOUT_MS=5000
