{
  "env": {
    "SERVER_HEDERA_ADDRESS": { "required": true, "roles": ["server"] },
    "CLIENT_HEDERA_ACCOUNT_ID": { "required": true, "roles": ["client"] },
    "CLIENT_HEDERA_PRIVATE_KEY": { "required": true, "roles": ["client"] },
    "FACILITATOR_HEDERA_ACCOUNT_ID": { "required": true, "roles": ["facilitator"] },
    "FACILITATOR_HEDERA_PRIVATE_KEY": { "required": true, "roles": ["facilitator"] },
    "HEDERA_AMOUNT": { "required": false, "roles": ["server"] },
    "HEDERA_ASSET": { "required": false, "roles": ["server"] },
    "HEDERA_TE_EXECUTOR_ID": { "required": false, "roles": ["server", "client", "facilitator"] },
    "HEDERA_TE_AUTHORIZATION": { "required": false, "roles": ["client"] },
    "HEDERA_TE_PAYER_ACCOUNT_ID": { "required": false, "roles": ["client"] },
    "HEDERA_TE_AMOUNT": { "required": false, "roles": ["server"] },
    "HEDERA_TE_ASSET": { "required": false, "roles": ["server"] },
    "HEDERA_TE_GAS_LIMIT": { "required": false, "roles": ["facilitator"] },
    "HEDERA_MIRROR_NODE_URL": { "required": false, "roles": ["facilitator"] }
  },
  "testnet": {
    "name": "Hedera Testnet",
    "caip2": "hedera:testnet",
    "rpcUrlDefault": ""
  },
  "mainnet": {
    "name": "Hedera Mainnet",
    "caip2": "hedera:mainnet",
    "rpcUrlDefault": ""
  },
  "routes": {
    "/exact/hedera": {
      "scheme": "exact",
      "sdks": ["typescript"],
      "price": {
        "amount": "100000",
        "amountEnv": "HEDERA_AMOUNT",
        "asset": "0.0.0",
        "assetEnv": "HEDERA_ASSET"
      },
      "extensions": ["bazaar"]
    },
    "/exact/hedera/upfront": {
      "scheme": "exact",
      "sdks": ["typescript"],
      "paymentFlow": "upfront",
      "price": {
        "amount": "100000",
        "amountEnv": "HEDERA_AMOUNT",
        "asset": "0.0.0",
        "assetEnv": "HEDERA_ASSET"
      },
      "extensions": ["bazaar"]
    },
    "/exact/hedera/transferExecutor": {
      "scheme": "exact",
      "assetTransferMethod": "transferExecutor",
      "requiresEnv": "HEDERA_TE_EXECUTOR_ID",
      "sdks": ["typescript"],
      "price": {
        "amount": "100000",
        "amountEnv": "HEDERA_TE_AMOUNT",
        "asset": "0.0.0",
        "assetEnv": "HEDERA_TE_ASSET"
      },
      "extensions": ["bazaar"]
    },
    "/exact/hedera/transferExecutor/upfront": {
      "scheme": "exact",
      "assetTransferMethod": "transferExecutor",
      "requiresEnv": "HEDERA_TE_EXECUTOR_ID",
      "sdks": ["typescript"],
      "paymentFlow": "upfront",
      "price": {
        "amount": "100000",
        "amountEnv": "HEDERA_TE_AMOUNT",
        "asset": "0.0.0",
        "assetEnv": "HEDERA_TE_ASSET"
      },
      "extensions": ["bazaar"]
    }
  }
}
