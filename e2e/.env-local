# E2E wallet/payee placeholders — copy to e2e/.env and fill in.
# Keys mirror required credentials in config/mechanisms_<id>.json (see e2e/README.md § Add a network).
# Optional route overrides (SERVER_*_AMOUNT/ASSET, batch-settlement, TVM provider, RPC) are not listed here.

# Server payment addresses
SERVER_EVM_ADDRESS=
SERVER_SVM_ADDRESS=
SERVER_SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=
SERVER_AVM_ADDRESS=
SERVER_APTOS_ADDRESS=
SERVER_CCD_ADDRESS=
SERVER_HEDERA_ADDRESS=
SERVER_KEETA_ADDRESS=
SERVER_STARKNET_ADDRESS=
SERVER_STELLAR_ADDRESS=
SERVER_TVM_ADDRESS=
SERVER_NEAR_ADDRESS=
SERVER_XRPL_ADDRESS=

# Client wallets
CLIENT_EVM_PRIVATE_KEY=
CLIENT_SVM_PRIVATE_KEY=
CLIENT_AVM_PRIVATE_KEY=
CLIENT_APTOS_PRIVATE_KEY=
CLIENT_CCD_PRIVATE_KEY=
CLIENT_CCD_ADDRESS=
CLIENT_HEDERA_ACCOUNT_ID=
CLIENT_HEDERA_PRIVATE_KEY=
CLIENT_KEETA_MNEMONIC=
CLIENT_STARKNET_ADDRESS=
CLIENT_STARKNET_PRIVATE_KEY=
CLIENT_STELLAR_PRIVATE_KEY=
CLIENT_TVM_PRIVATE_KEY=
CLIENT_NEAR_ACCOUNT_ID=
CLIENT_NEAR_PRIVATE_KEY=
CLIENT_XRPL_SEED=

# Facilitator wallets (XRPL facilitator is keyless — no FACILITATOR_XRPL_*)
FACILITATOR_EVM_PRIVATE_KEY=
FACILITATOR_SVM_PRIVATE_KEY=
FACILITATOR_AVM_PRIVATE_KEY=
FACILITATOR_APTOS_PRIVATE_KEY=
FACILITATOR_CCD_PRIVATE_KEY=
FACILITATOR_CCD_ADDRESS=
FACILITATOR_HEDERA_ACCOUNT_ID=
FACILITATOR_HEDERA_PRIVATE_KEY=
FACILITATOR_KEETA_MNEMONIC=
FACILITATOR_STARKNET_ADDRESS=
FACILITATOR_STARKNET_PRIVATE_KEY=
FACILITATOR_STELLAR_PRIVATE_KEY=
FACILITATOR_TVM_PRIVATE_KEY=
FACILITATOR_NEAR_ACCOUNT_ID=
FACILITATOR_NEAR_PRIVATE_KEY=
