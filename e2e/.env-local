# E2E wallet/payee placeholders — copy to e2e/.env and fill in.
# Keys mirror required credentials in config/mechanisms_<id>.json (see e2e/README.md § Add a network).
# Optional route overrides (SERVER_*_AMOUNT/ASSET, TVM provider, RPC) and batch-settlement toggles are commented below where applicable.

# Server payment addresses
SERVER_EVM_ADDRESS=
SERVER_SVM_ADDRESS=
# Optional: self-managed auth-capture sync routes (/auth-capture/evm/*). Leave unset for facilitator-delegated auth-capture routes.
SERVER_EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=
SERVER_SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=
SERVER_SVM_OPERATOR_PRIVATE_KEY=
SERVER_AVM_ADDRESS=
SERVER_APTOS_ADDRESS=
SERVER_CCD_ADDRESS=
SERVER_HEDERA_ADDRESS=
SERVER_KEETA_ADDRESS=
SERVER_STELLAR_ADDRESS=
SERVER_TVM_ADDRESS=
SERVER_NEAR_ADDRESS=
SERVER_XRPL_ADDRESS=
SERVER_CARDANO_ADDRESS=
SERVER_CANTON_ADDRESS=
SERVER_CANTON_INSTRUMENT_ADMIN=
# The payee's key, used only by `pnpm canton:setup` to create its TransferPreapproval.
SERVER_CANTON_PRIVATE_KEY=

# Client wallets
CLIENT_EVM_PRIVATE_KEY=
CLIENT_EVM_BATCH_SETTLEMENT_VOUCHER_SIGNER_PRIVATE_KEY=
# EVM_BATCH_SETTLEMENT_RECOVERY=true
CLIENT_SVM_PRIVATE_KEY=
CLIENT_SVM_SERVER_SIGNED_OPERATORS=
CLIENT_SVM_SERVER_SIGNED_MAX_DEPOSIT=
# SVM_BATCH_SETTLEMENT_RECOVERY=true
CLIENT_AVM_PRIVATE_KEY=
CLIENT_APTOS_PRIVATE_KEY=
CLIENT_CASPER_PRIVATE_KEY=
CLIENT_CASPER_PRIVATE_KEY_ALGORITHM=
CLIENT_CCD_PRIVATE_KEY=
CLIENT_CCD_ADDRESS=
CLIENT_HEDERA_ACCOUNT_ID=
CLIENT_HEDERA_PRIVATE_KEY=
CLIENT_KEETA_MNEMONIC=
CLIENT_STELLAR_PRIVATE_KEY=
CLIENT_TVM_PRIVATE_KEY=
CLIENT_NEAR_ACCOUNT_ID=
CLIENT_NEAR_PRIVATE_KEY=
CLIENT_XRPL_SEED=
CLIENT_CARDANO_MNEMONIC=
CLIENT_CANTON_PARTY=
CLIENT_CANTON_PRIVATE_KEY=

# Facilitator wallets (XRPL facilitator is keyless — no FACILITATOR_XRPL_*)
FACILITATOR_EVM_PRIVATE_KEY=
# Optional auth-capture custom operator allowlist (defaults to Base Sepolia ForwardingOperator)
# FACILITATOR_EVM_AUTH_CAPTURE_CUSTOM_OPERATORS=0x8FE415CdB559fBF5B235B81CC4F7a69684A274bb
FACILITATOR_SVM_PRIVATE_KEY=
FACILITATOR_SVM_BATCH_BINDING_STORE=
SVM_ARCHIVE_RPC_URL=
FACILITATOR_AVM_PRIVATE_KEY=
FACILITATOR_APTOS_PRIVATE_KEY=
FACILITATOR_CASPER_PRIVATE_KEY=
FACILITATOR_CASPER_PRIVATE_KEY_ALGORITHM=
FACILITATOR_CCD_PRIVATE_KEY=
FACILITATOR_CCD_ADDRESS=
FACILITATOR_HEDERA_ACCOUNT_ID=
FACILITATOR_HEDERA_PRIVATE_KEY=
FACILITATOR_KEETA_MNEMONIC=
FACILITATOR_STELLAR_PRIVATE_KEY=
FACILITATOR_TVM_PRIVATE_KEY=
FACILITATOR_NEAR_ACCOUNT_ID=
FACILITATOR_NEAR_PRIVATE_KEY=
FACILITATOR_CARDANO_MNEMONIC=
FACILITATOR_CANTON_PARTY=

# Canton participant (JSON Ledger API) shared by the client, facilitator and canton:setup,
# and the SV Scan the client resolves transfer factories on.
CANTON_PARTICIPANT_URL=
CANTON_TOKEN=
CANTON_USER_ID=
CANTON_SYNCHRONIZER_ID=
CANTON_SCAN_URL=
# CANTON_SCAN_TOKEN=

BLOCKFROST_PROJECT_ID=
CARDANO_L1_CONFIRMATIONS=
SERVER_CARDANO_SELLER_MNEMONIC=
SERVER_EVM_BATCH_SETTLEMENT_REFUND_AUTHORIZER_PRIVATE_KEY=
# Optional script-route overrides (defaults: always-succeeds Plutus V3 fixture)
# SERVER_CARDANO_SCRIPT_ADDRESS=
# SERVER_CARDANO_SCRIPT_CODE=
# SERVER_CARDANO_SCRIPT_DATUM=
