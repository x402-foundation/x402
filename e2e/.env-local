# E2E wallet/payee placeholders — copy to e2e/.env and fill in.
# Keys mirror required credentials in config/mechanisms_<id>.json (see e2e/README.md § Add a network).
# Optional route overrides (SERVER_*_AMOUNT/ASSET, TVM provider, RPC) and batch-settlement toggles are commented below where applicable.

# Server payment addresses
SERVER_EVM_ADDRESS=
SERVER_SVM_ADDRESS=
# Optional batch-settlement / upto (see e2e/README.md)
SERVER_EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=
SERVER_SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=
SERVER_SVM_OPERATOR_PRIVATE_KEY=
SERVER_AVM_ADDRESS=
SERVER_APTOS_ADDRESS=
SERVER_CCD_ADDRESS=
SERVER_HEDERA_ADDRESS=
SERVER_KEETA_ADDRESS=
SERVER_STELLAR_ADDRESS=
SERVER_TVM_ADDRESS=
SERVER_NEAR_ADDRESS=
SERVER_XRPL_ADDRESS=
SERVER_CARDANO_ADDRESS=

# Client wallets
CLIENT_EVM_PRIVATE_KEY=
CLIENT_EVM_BATCH_SETTLEMENT_VOUCHER_SIGNER_PRIVATE_KEY=
# EVM_BATCH_SETTLEMENT_RECOVERY=true
CLIENT_SVM_PRIVATE_KEY=
CLIENT_SVM_SERVER_SIGNED_OPERATORS=
CLIENT_SVM_SERVER_SIGNED_MAX_DEPOSIT=
# SVM_BATCH_SETTLEMENT_RECOVERY=true
CLIENT_AVM_PRIVATE_KEY=
CLIENT_APTOS_PRIVATE_KEY=
CLIENT_CASPER_PRIVATE_KEY=
CLIENT_CASPER_PRIVATE_KEY_ALGORITHM=
CLIENT_CCD_PRIVATE_KEY=
CLIENT_CCD_ADDRESS=
CLIENT_HEDERA_ACCOUNT_ID=
CLIENT_HEDERA_PRIVATE_KEY=
CLIENT_KEETA_MNEMONIC=
CLIENT_STELLAR_PRIVATE_KEY=
CLIENT_TVM_PRIVATE_KEY=
CLIENT_NEAR_ACCOUNT_ID=
CLIENT_NEAR_PRIVATE_KEY=
CLIENT_XRPL_SEED=
CLIENT_CARDANO_MNEMONIC=

# Facilitator wallets (XRPL facilitator is keyless — no FACILITATOR_XRPL_*)
FACILITATOR_EVM_PRIVATE_KEY=
FACILITATOR_SVM_PRIVATE_KEY=
FACILITATOR_SVM_BATCH_BINDING_STORE=
SVM_ARCHIVE_RPC_URL=
FACILITATOR_AVM_PRIVATE_KEY=
FACILITATOR_APTOS_PRIVATE_KEY=
FACILITATOR_CASPER_PRIVATE_KEY=
FACILITATOR_CASPER_PRIVATE_KEY_ALGORITHM=
FACILITATOR_CCD_PRIVATE_KEY=
FACILITATOR_CCD_ADDRESS=
FACILITATOR_HEDERA_ACCOUNT_ID=
