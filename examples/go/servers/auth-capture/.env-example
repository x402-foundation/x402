EVM_PAYEE_ADDRESS=0x...
FACILITATOR_URL=http://localhost:4022

# Optional: self-managed receiver authorizer that signs the Capture/Void EIP-712 messages.
# Omit to delegate lifecycle signing to the facilitator (extra.receiverAuthorizer on /supported).
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=0x...

# Custom-escrow flow only (`go run . custom-escrow`).
# Must match an entry in the facilitator's CUSTOM_OPERATOR_ALLOWLIST.
# CUSTOM_OPERATOR_ADDRESS=0x8FE415CdB559fBF5B235B81CC4F7a69684A274bb

# Optional listen port (default 4021)
# PORT=
