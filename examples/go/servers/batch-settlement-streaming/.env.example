# EVM address that receives funds (checksummed 20-byte hex)
EVM_ADDRESS=0x...

# Optional: dedicated receiver-authorizer EOA. If unset, the facilitator signs.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Facilitator URL (REST endpoint that performs verify/settle on-chain)
FACILITATOR_URL=http://localhost:4020

# Optional: persist server-side session state across restarts
STORAGE_DIR=

# Tokens per priced chunk (default 100)
CHUNK_SIZE=100

# Withdraw delay (seconds) — minimum enforced by the contract
DEFERRED_WITHDRAW_DELAY_SECONDS=

# Verbose voucher-event logging (truthy: 1, true, yes, on)
VERBOSE=
