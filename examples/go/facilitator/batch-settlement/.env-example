# At least one of EVM_PRIVATE_KEY or SVM_PRIVATE_KEY is required.
EVM_PRIVATE_KEY=0x...
SVM_PRIVATE_KEY=

EVM_RPC_URL=https://sepolia.base.org
SVM_RPC_URL=
# Optional full-history RPC. Recovers the receiver-authorizer binding after a restart.
SVM_ARCHIVE_RPC_URL=

# Optional dedicated EVM authorizer key. Required when VOUCHER_STORE is enabled.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Facilitator-managed voucher custody (spec v1.1). Pair with VOUCHER_STORE_MODE=facilitator on the server.
# VOUCHER_STORE=true
# VOUCHER_STORE_DIR=./voucher-store   # optional; omit for in-memory (default)
# VOUCHER_STORE_WITHDRAW_DELAY_SECONDS=900

# Optional ERC-8021 builder code for scheduled claim attribution.
# FACILITATOR_BUILDER_CODE=

# Rent cleanup (SVM only). Interval between cleanup ticks in seconds.
RENT_CLEANUP_INTERVAL_SECS=30
# Grace after voucher expiry before abandon-close (default 120).
RENT_CLEANUP_ABANDON_GRACE_SECS=120

# Optional (default 4022). Same as examples/typescript/facilitator/batch-settlement.
PORT=
