# Solana Devnet key that fee-pays channel opens and settlements. Needs SOL.
SVM_PRIVATE_KEY=
SVM_RPC_URL=https://api.devnet.solana.com

# Seconds between rent cleanup passes.
RENT_CLEANUP_INTERVAL_SECS=300
# Grace after voucher expiry before an abandoned Open channel is sealed.
RENT_CLEANUP_ABANDON_GRACE_SECS=120
# Max channel lifetime accepted at verify/deposit, in seconds.
MAX_CHANNEL_LIFETIME_SECS=3600

PORT=4022
