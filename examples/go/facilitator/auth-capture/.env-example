EVM_PRIVATE_KEY=0x...
EVM_RPC_URL=https://sepolia.base.org

# Optional dedicated receiver authorizer (recommended: separate from the relayer).
# When set, advertised in GET /supported as extra.receiverAuthorizer; resource servers can omit
# EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY and delegate lifecycle signing to this facilitator.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Optional fee terms advertised to servers/clients (omit for no fee)
FEE_RECIPIENT=
MIN_FEE_BPS=0
MAX_FEE_BPS=0

# Comma-separated custom operator contracts this facilitator will relay collect for
# (advertised in GET /supported as extra.operators). Leave empty to admit none.
CUSTOM_OPERATOR_ALLOWLIST=

# Optional listen port (default 4022)
PORT=
