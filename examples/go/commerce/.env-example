# Client/payer wallet private key (hex, without 0x prefix)
CLIENT_PRIVATE_KEY=your_client_private_key_here

# Operator/facilitator wallet private key (hex, without 0x prefix)
# This must be the operator address authorized to call escrow functions
OPERATOR_PRIVATE_KEY=your_operator_private_key_here

# Base Mainnet RPC URL
RPC_URL=https://mainnet.base.org

# AuthCaptureEscrow contract address (Base Mainnet)
ESCROW_ADDRESS=0xBdEA0D1bcC5966192B070Fdf62aB4EF5b4420cff

# ERC3009PaymentCollector contract address (Base Mainnet)
TOKEN_COLLECTOR_ADDRESS=0x0E3dF9510de65469C4518D7843919c0b8C7A7757

# Payment receiver address
RECEIVER_ADDRESS=your_receiver_address_here
