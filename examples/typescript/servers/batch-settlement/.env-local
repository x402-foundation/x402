# At least one of EVM_ADDRESS or SVM_ADDRESS is required.
EVM_ADDRESS=0x...
SVM_ADDRESS=

FACILITATOR_URL=http://localhost:4022

# EVM self-managed mode (default): local receiver authorizer. Channels survive facilitator changes.
# Omit to delegate to the facilitator's advertised authorizer (channels bind to that facilitator).
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# EVM facilitator-managed mode: set to "facilitator" and use a facilitator that advertises voucherManager "facilitator".
# Do not set EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY in this mode.
# VOUCHER_STORE_MODE=facilitator
# EVM_REFUND_AUTHORIZER_PRIVATE_KEY=0x...  # cooperative refunds (or rely on facilitator delegatedRefund)

# SVM: optional receiver authorizer for cooperative close (base58 private key).
SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# SVM: optional operator key (base58 private key). When set, the route is offered
# server-signed (metered: the handler bills a fraction of the ceiling) next to a
# client-signed accept at the ceiling. Clients only use the server-signed accept for
# operator keys they trust (see the client's SVM_SERVER_SIGNED_OPERATORS).
SVM_OPERATOR_PRIVATE_KEY=

STORAGE_DIR=
DEFERRED_WITHDRAW_DELAY_SECONDS=900
