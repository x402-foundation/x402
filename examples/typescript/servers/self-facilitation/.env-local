EVM_PRIVATE_KEY=
# Optional. Defaults to Base Sepolia.
# Supported values in this example:
# eip155:84532 (Base Sepolia)
# eip155:8453  (Base Mainnet)
# eip155:137   (Polygon Mainnet)
# eip155:80002 (Polygon Amoy)
EVM_NETWORK=eip155:84532
# Optional explicit RPC URL. Recommended for production deployments.
EVM_RPC_URL=
