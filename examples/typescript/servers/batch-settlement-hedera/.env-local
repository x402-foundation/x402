# Server account that receives USDC (must be associated with the token)
HEDERA_ACCOUNT_ID=
# Optional: self-managed receiver authorizer (a Hedera account + key). When omitted the facilitator's
# advertised receiverAuthorizer is used.
HEDERA_RECEIVER_AUTHORIZER_ACCOUNT_ID=
HEDERA_RECEIVER_AUTHORIZER_PRIVATE_KEY=
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=http://localhost:4022
# Optional durable channel storage directory
STORAGE_DIR=
# Timed-withdrawal delay committed into new channels (seconds, 900 – 2592000)
WITHDRAW_DELAY_SECONDS=86400
