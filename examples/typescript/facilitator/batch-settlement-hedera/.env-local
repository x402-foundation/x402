# Facilitator operator account (pays gas, submits deposit/claim/settle/refund contract calls)
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Optional: separate account whose key signs ClaimBatch / Refund digests (advertised as receiverAuthorizer)
HEDERA_RECEIVER_AUTHORIZER_ACCOUNT_ID=
HEDERA_RECEIVER_AUTHORIZER_PRIVATE_KEY=
HEDERA_NETWORK=hedera:testnet
# Optional Mirror Node override
HEDERA_MIRROR_NODE_URL=
PORT=4022
