<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone example; not part of the java/ reactor. Install the SDK first:
       mvn -f java/pom.xml install -DskipTests -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>org.x402.examples</groupId>
  <artifactId>spring-rest-client</artifactId>
  <version>0.0.0</version>
  <name>x402 example: Spring RestClient / @HttpExchange client</name>

  <properties>
    <java.version>17</java.version>
    <x402.version>2.0.0-SNAPSHOT</x402.version>
    <wiremock.version>3.13.1</wiremock.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.x402</groupId>
      <artifactId>x402-spring-boot-starter</artifactId>
      <version>${x402.version}</version>
    </dependency>
    <!-- The payment mechanism: the starter brings none, you add the chains you accept. -->
    <dependency>
      <groupId>org.x402</groupId>
      <artifactId>x402-mechanism-cardano</artifactId>
      <version>${x402.version}</version>
    </dependency>
    <!-- A command-line app: RestClient without a web server. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
