# ── x402 Example — Environment Config ─────────────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# Your test wallet private key (Base Sepolia only — never use a funded mainnet key)
PRIVATE_KEY=0x<your-test-wallet-private-key>

# The receiving agent's wallet address (default: Hardhat account #1)
RECEIVING_AGENT_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Base Sepolia RPC (public — no API key needed)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# USDC on Base Sepolia (official Circle deployment)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── Python receiving agent settings ───────────────────────────────────────────
# Set to "sepolia" to enable real on-chain settlement in app.py
SETTLEMENT_MODE=local

# Private key for the receiving agent wallet (only needed in sepolia mode)
# This wallet pays the gas for the USDC transferWithAuthorization call
AGENT_PRIVATE_KEY=0x<receiving-agent-private-key>
