# Copy to `.env.local` (gitignored) and fill in. Used by the env-gated live tests in
# test/integrations and by the scripts in test/integrations/mock-executor.
# Fund the accounts from https://portal.hedera.com/ first. Never commit real keys.

# --- Facilitator: the fee payer that submits transactions (ECDSA key, DER or 0x-hex) ---
HEDERA_FACILITATOR_ACCOUNT_ID=
HEDERA_FACILITATOR_PRIVATE_KEY=

# --- Resource server: `payTo`. Must differ from the facilitator account. ---
# `pnpm exec tsx --env-file=.env.local test/integrations/mock-executor/create-account.ts` makes one.
HEDERA_RESOURCE_SERVER_ACCOUNT_ID=

# --- Corner-case suite (exact-hedera.transferExecutor.cornerCases.test.ts) ---
# The deployed MockTransferExecutor, from mock-executor/deploy.ts. It pays from its own
# balance, so it is also the payer. The suite is skipped unless this is set.
HEDERA_TE_MOCK_EXECUTOR_ID=

# --- Signed-owner suite (exact-hedera.transferExecutor.signedOwner.test.ts) ---
# The deployed SignedOwnerExecutor (`deploy.ts SignedOwnerExecutor`). It holds no funds: each run
# creates an owner account and grants this contract an HBAR allowance. Skipped unless set.
HEDERA_TE_SIGNED_EXECUTOR_ID=

# --- Single-payment live test (exact-hedera.transferExecutor.test.ts), any executor ---
HEDERA_TE_EXECUTOR_ID=
HEDERA_TE_PAYER_ACCOUNT_ID=
# Single-use: prepare shortly before running (mock-executor/authorize.ts prints one for the mock).
HEDERA_TE_AUTHORIZATION=
HEDERA_TE_AMOUNT=100000

# --- Optional ---
# HEDERA_TE_ASSET=0.0.0             # 0.0.0 (HBAR, default) or an HTS token id
# HEDERA_TE_GAS_LIMIT=400000        # simulation and submission gas limit
# HEDERA_MIRROR_NODE_URL=           # defaults to the public testnet mirror node
# HEDERA_TE_EXTRA_RECIPIENT_ACCOUNT_ID=   # deploy.ts: recipient of the mock's EXTRA_CREDIT mode
# HEDERA_TE_FUND_HBAR=20            # deploy.ts: HBAR deposited into the mock
