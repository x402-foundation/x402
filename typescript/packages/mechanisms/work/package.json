{
  "name": "@x402/work",
  "version": "2.29.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "build": "tsup && node ../../../scripts/mirror-cjs-dts.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [
    "x402",
    "payment",
    "protocol",
    "proof-of-work"
  ],
  "license": "Apache-2.0",
  "author": "x402 Foundation",
  "repository": "https://github.com/x402-foundation/x402",
  "description": "Profile-defined proof-of-work payments for x402",
  "dependencies": {
    "@x402/core": "workspace:~"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-sonarjs": "^3.0.7",
    "prettier": "3.5.2",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/esm/client/index.d.mts",
        "default": "./dist/esm/client/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/client/index.d.ts",
        "default": "./dist/cjs/client/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server/index.d.mts",
        "default": "./dist/esm/server/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/server/index.d.ts",
        "default": "./dist/cjs/server/index.js"
      }
    },
    "./facilitator": {
      "import": {
        "types": "./dist/esm/facilitator/index.d.mts",
        "default": "./dist/esm/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/facilitator/index.d.ts",
        "default": "./dist/cjs/facilitator/index.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
